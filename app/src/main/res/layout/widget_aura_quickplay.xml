<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="Album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/aura_app_icon_round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Aura Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tap to listen"
                    android:textColor="#C7FFFFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Aura Music"
                android:scaleType="centerCrop"
                android:src="@drawable/aura_app_icon_round" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_btn_prev"
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/widget_prev_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="Previous track"
                    android:src="@drawable/ic_widget_prev" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_play_circle">

                <ImageView
                    android:id="@+id/widget_play_pause_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play or Pause"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_btn_next"
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/widget_next_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="Next track"
                    android:src="@drawable/ic_widget_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
