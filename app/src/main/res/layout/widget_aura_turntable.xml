<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Album artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/aura_app_icon_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aura Music"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to listen"
                android:textColor="#C7FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Aura Music"
            android:scaleType="centerCrop"
            android:src="@drawable/aura_app_icon_round" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/widget_prev_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="Previous track"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_play_circle">

            <ImageView
                android:id="@+id/widget_play_pause_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Play or Pause"
                android:src="@drawable/ic_widget_play" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/widget_next_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="Next track"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
